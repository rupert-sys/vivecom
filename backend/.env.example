ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://vivecom:vivecom@localhost:5432/vivecom
JWT_SECRET=cambia-esto-por-un-valor-aleatorio-largo
CORS_ORIGINS=http://localhost:5173

# Archivos subidos (comprobantes). En desarrollo van a disco local; en producción DEBEN ir a S3
# (el backend se niega a arrancar el almacenamiento local con ENVIRONMENT=production).
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
# STORAGE_BACKEND=s3
# STORAGE_S3_BUCKET=vivecom-uploads-production   # bucket PRIVADO (ver infra/main.tf)
# STORAGE_S3_REGION=us-east-1
# Base de los enlaces firmados a los archivos: la URL pública de la API.
PUBLIC_BASE_URL=http://localhost:8000
