# Sirve el panel (React) y la app web de residentes (Flutter) dentro de la red de Docker; el HTTPS lo pone
# Cloudflare Tunnel. Cada sitio se distingue por su nombre de host. Ambos son SPA: una ruta SIN extensión cae en
# index.html; un archivo (algo.js, algo.apk) que no existe da 404 y NO la página de la app (Cloudflare cachea por
# extensión: un comodín con código 200 quedó guardado como si fuera el APK).
{
	auto_https off
}

(spa) {
	encode gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	# Los archivos de la app web (main.dart.js, flutter_bootstrap.js…) no llevan huella en el nombre: si Cloudflare o
	# el navegador los guardan horas, tras publicar una versión nueva los usuarios siguen viendo la vieja.
	# «no-cache» = guardar pero preguntar siempre al origen (ETag → 304, casi gratis).
	@apk path *.apk
	@resto not path *.apk
	header @resto Cache-Control "no-cache"
	header @apk Cache-Control "no-store"

	@archivo path_regexp archivo \.[A-Za-z0-9]{1,8}$
	handle @archivo {
		file_server
	}
	handle {
		try_files {path} /index.html
		file_server
	}
}

http://app.{$DOMAIN} {
	root * /srv/app
	import spa
}

# panel.<dominio>, y cualquier otro host (p. ej. http://127.0.0.1:8081 al probar sin el túnel)
:80 {
	root * /srv/panel
	import spa
}
