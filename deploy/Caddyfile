# Sirve el panel (React) y la app web de residentes (Flutter) dentro de la red de Docker; el HTTPS lo pone
# Cloudflare Tunnel. Cada sitio se distingue por su nombre de host. Ambos son SPA: una ruta SIN extensión cae en
# index.html; un archivo (algo.js, algo.apk) que no existe da 404 y NO la página de la app (Cloudflare cachea por
# extensión: un comodín con código 200 quedó guardado como si fuera el APK).
{
	auto_https off
}

(spa) {
	encode gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	@archivo path_regexp archivo \.[A-Za-z0-9]{1,8}$
	handle @archivo {
		file_server
	}
	handle {
		try_files {path} /index.html
		file_server
	}
}

# App web de residentes (Flutter): main.dart.js, flutter_bootstrap.js, los fonts y el manifiesto NO llevan huella en el
# nombre, y Cloudflare reescribe a 4 horas el plazo de los .js/.json/.otf aunque el origen pida max-age=0 o no-cache
# (solo respeta no-store). Sin esto, tras publicar una versión los usuarios siguen viendo la anterior hasta 4 horas.
# Se exceptúa /canvaskit/ (el motor gráfico, varios MB, versionado con Flutter) para no descargarlo en cada visita.
http://app.{$DOMAIN} {
	root * /srv/app
	@sin_cache not path /canvaskit/*
	header @sin_cache Cache-Control "no-store"
	import spa
}

# Portal de administrador principal (staff Vivecom, React): lista y administra TODOS los condominios, con su
# propio login (/staff/login) sin relación con ningún tenant — ver staff-frontend/. Necesita su propio bloque
# de host explícito: sin esto caería en el catch-all :80 de abajo (pensado para panel.<dominio>).
# AVISO: en este modo (detrás de Cloudflare Tunnel) además hace falta agregar la ruta de admin.<dominio> al
# config.yml del túnel (fuera del repo, ver deploy/README.md) — sin eso, Cloudflare nunca llega a este bloque.
http://admin.{$DOMAIN} {
	root * /srv/admin
	header Cache-Control "no-cache"
	import spa
}

# panel.<dominio>, y cualquier otro host (p. ej. http://127.0.0.1:8081 al probar sin el túnel). Los .js del panel llevan
# huella (assets/index-<huella>.js), así que su caché no estorba; index.html no lo cachea Cloudflare.
:80 {
	root * /srv/panel
	header Cache-Control "no-cache"
	import spa
}
