# Copiar a .env y llenar. .env NO se sube al repositorio (ya está en .gitignore).

# Dominio propio en Cloudflare: la API queda en api.<DOMAIN> y el panel en panel.<DOMAIN>.
# Se queda igual al mudarse de máquina, así que las apps no hay que recompilarlas.
DOMAIN=vivecom.example

# Contraseña de la base de datos (una larga y aleatoria):  openssl rand -base64 24
POSTGRES_PASSWORD=

# Firma de sesiones. NO usar la de desarrollo:  openssl rand -hex 32
JWT_SECRET=

# Firma del webhook de STP/SPEI. Con ENVIRONMENT=production el backend rechaza el valor de ejemplo.
# Mientras no haya cuenta con STP, cualquier valor aleatorio:  openssl rand -hex 32
STP_WEBHOOK_SECRET=

# (El túnel de Cloudflare ya no usa un token en el .env: ver deploy/cloudflared/ y README.md.)

# Opcional: monitoreo de errores (vacío = desactivado).
SENTRY_DSN=
